# 统一换行策略：仓库内存 LF（跨平台 diff 干净），检出时按平台处理。
* text=auto eol=lf

*.py    text eol=lf
*.pyi   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.j2    text eol=lf
*.lock  text eol=lf

# Windows 批处理与 PowerShell 脚本用 CRLF 更稳
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.whl   binary
*.zip   binary
